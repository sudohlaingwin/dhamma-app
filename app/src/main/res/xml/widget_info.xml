<?xml version="1.0" encoding="utf-8"?>
<!-- v12.67: Home Screen Widget info — 4x1 cells, horizontal resize
     only, push-driven updates (updatePeriodMillis 0: the service
     pushes a refresh on every state edge, never polled).
     v13.09 (widget F6): previewLayout + description so the Android
     12+ widget picker shows the real widget and a line about it
     instead of a blank tile; (F7) minHeight 112dp — the content
     measures ~111dp (10+10 padding, 12sp app, 16sp title, 48dp
     button row), so 110dp squeezed the button row 1dp on strict
     hosts.
     v13.84 (large-font clip note, widget-audit-1346): padding
     trimmed to 6dp top/bottom (layout file) — content now ~104dp
     at default font, ~110dp at Large (1.15x, fits) and ~116dp at
     Largest (1.3x, only transparent button padding cut, 24dp
     icons clear by ~8dp); minHeight stays 112dp, resizeMode
     stays horizontal-only. No device check exists on this VM;
     the numbers are sim1415.py arithmetic on the phone's font
     (k=1.362, audit anchor k=1.32); the desktop-font k=2.184
     model is refuted there (it would already cut the icons at
     default font, which the shipped widget does not do). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="112dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_dhamma"
    android:previewLayout="@layout/widget_dhamma"
    android:description="@string/widget_desc"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
