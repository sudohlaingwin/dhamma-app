<?xml version="1.0" encoding="utf-8"?>
<!-- v12.67: widget background — dark translucent rounded rect with
     a gold rim, readable on any wallpaper (the widget cannot follow
     the app's day/night theme, so one dark glass face serves both).
     All four corners rounded, unlike the Room's glass_panel whose
     bottom corners are square. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#D91E140E" />
    <stroke android:width="1dp" android:color="#66C9A227" />
    <corners android:radius="16dp" />
</shape>
