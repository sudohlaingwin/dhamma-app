<?xml version="1.0" encoding="utf-8"?>
<!-- v13.02 (user order 2026-11-07 ~22:34 +07: UI ပိုလှအောင်၊ ကြွရွလှနေအောင်):
     Liquid Glass gloss pass — the v2.44/v5.51 glass language, deepened:
     a soft drop shadow under the card, a brighter dome sheen on top,
     a diagonal gloss sweep (light from the upper left), and a brighter
     gold rim. Same file name / same corners, so Main grid cards, Talks
     rows and History cards all pick it up with zero code changes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow: dark layer, body sits 3dp above it. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Glass body. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
            <stroke android:width="1dp" android:color="#CCC9A227" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Dome sheen: bright top fading down. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B3FFFFFF" android:centerColor="#26FFFFFF" android:centerY="0.42" android:endColor="#00FFFFFF" android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Diagonal gloss sweep: light from the upper left. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#40FFFFFF" android:centerColor="#0DFFFFFF" android:centerY="0.5" android:endColor="#00FFFFFF" android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
