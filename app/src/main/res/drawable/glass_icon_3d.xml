<?xml version="1.0" encoding="utf-8"?>
<!-- v13.02 gloss pass on the v5.51 embossed Liquid Glass icon button:
     dome top brightened (#CC -> #E6 white), gold rim brightened
     (#B3 -> #E6 gold), top bevel light strengthened — every Room icon
     button and every mini-player strip button reads glossier, same
     geometry, same name, zero code changes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom shadow: dark layer, body inset above it. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Raised glass body: bright top, dark bottom. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:centerColor="#40FFFFFF"
                android:centerY="0.42"
                android:endColor="#33000000"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#E6C9A227" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Top bevel light: thin bright band across the top. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#CCFFFFFF"
                android:centerColor="#33FFFFFF"
                android:centerY="0.35"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
