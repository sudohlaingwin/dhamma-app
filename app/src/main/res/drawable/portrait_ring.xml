<?xml version="1.0" encoding="utf-8"?>
<!-- v13.02 (NEW): gold gradient ring for the Main sayadaw portraits.
     The outer oval is a diagonal gold gradient; the 64dp CircleImageView
     child covers the centre, leaving a 2dp gold ring. The dark inner
     oval is only a fallback mask if a portrait fails to load. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#F5D76E"
                android:centerColor="#C9A227"
                android:endColor="#8A6D1B"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="#1E140E" />
        </shape>
    </item>
</layer-list>
