<?xml version="1.0" encoding="utf-8"?>
<!-- v13.02 (NEW): golden halo Play button for the Room main row —
     the v5.51 glass_icon_3d emboss, recast in gold: a gold gradient
     dome (light gold top to deep gold bottom), a bright 2dp gold rim,
     a white top bevel and a diagonal gloss sweep. The white vector
     play glyph (ic_play) sits on top. Same geometry as glass_icon_3d,
     applied to roomPlayPause only. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom shadow: dark layer, body inset above it. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Raised gold body: light gold top, deep gold bottom. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F5D76E"
                android:centerColor="#C9A227"
                android:centerY="0.45"
                android:endColor="#8A6D1B"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#FFF5D76E" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Top bevel light: thin bright band across the top. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#CCFFFFFF"
                android:centerColor="#33FFFFFF"
                android:centerY="0.35"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Diagonal gloss sweep: light from the upper left. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#59FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:centerY="0.5"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
