<?xml version="1.0" encoding="utf-8"?>
<!-- v12.92: raised drawer row tile — subtle glass, rounded corners, top sheen, so each talk reads as its own embossed card instead of flat text on glass. The playing row uses drawer_row_playing.xml (gold). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom shadow: dark layer, tile inset above it. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Raised glass tile: bright top to dim bottom, thin gold rim. -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:centerColor="#14FFFFFF" android:centerY="0.5" android:endColor="#0AFFFFFF" android:type="linear" />
            <stroke android:width="1dp" android:color="#40C9A227" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Top bevel light. -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:centerColor="#14FFFFFF" android:centerY="0.35" android:endColor="#00FFFFFF" android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
