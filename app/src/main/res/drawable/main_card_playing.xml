<?xml version="1.0" encoding="utf-8"?>
<!-- v13.86 (slice 1078): sounding-sayadaw gold card tile — the Talks
     chooser's v13.83 gold tile, now on the Main grid cards too: same gold
     gradient + 2dp gold rim, 24dp radius like card_bg.xml so the grid
     card keeps its shape, plus the top sheen. Theme-independent like the
     row tiles: the gold reads on parchment and on dark alike, and the
     sounding name stays full gold (#C9A227) on it, exactly as the rows do.
     Body byte-identical to talks_row_playing.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#66C9A227" android:centerColor="#33C9A227" android:centerY="0.5" android:endColor="#1AC9A227" android:type="linear" />
            <stroke android:width="2dp" android:color="#E6C9A227" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#80FFFFFF" android:centerColor="#1AFFFFFF" android:centerY="0.45" android:endColor="#00FFFFFF" android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
