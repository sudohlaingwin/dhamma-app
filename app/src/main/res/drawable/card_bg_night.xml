<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: translucent base + gold rim + glossy top sheen + depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80020201" />
            <stroke android:width="1dp" android:color="#66C9A227" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:centerColor="#1AFFFFFF" android:centerY="0.45" android:endColor="#00FFFFFF" android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
