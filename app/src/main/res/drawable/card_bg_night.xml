<?xml version="1.0" encoding="utf-8"?>
<!-- v13.02 gloss pass (night twin of card_bg.xml): drop shadow + brighter
     dome sheen + diagonal gloss sweep + brighter gold rim, on the dark
     night base. Same name/corners — zero code changes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow: dark layer, body sits 3dp above it. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#60000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Glass body. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#80020201" />
            <stroke android:width="1dp" android:color="#99C9A227" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Dome sheen: bright top fading down. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:centerColor="#1AFFFFFF" android:centerY="0.42" android:endColor="#00FFFFFF" android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Diagonal gloss sweep: light from the upper left. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#26FFFFFF" android:centerColor="#0DFFFFFF" android:centerY="0.5" android:endColor="#00FFFFFF" android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
