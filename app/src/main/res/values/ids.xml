<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v8.01: tag key for the strip-drag talk identity (Fx.miniSeekBar).
         Not a view: a View tag key only, so a scrub that outlives its
         talk can be recognised at lift and discarded. -->
    <item name="stripDragUrl" type="id"/>
    <!-- v14.19: tag keys for the strip-bar glide (Fx.syncStripProgress).
         The running glide animator + its target ride on the bar itself,
         so they die with the view and can never strand across activities. -->
    <item name="stripGlideAnim" type="id"/>
    <item name="stripGlideTarget" type="id"/>
    <!-- v14.20: tag keys for the strip-glyph flip (Fx.flipStripGlyph).
         The running flip animator + the last shown glyph ride on the
         toggle itself, so they die with the view and a steady 1s tick
         never re-animates a settled glyph. -->
    <item name="stripGlyphAnim" type="id"/>
    <item name="stripGlyphLast" type="id"/>
    <!-- v14.21: tag keys for the strip-text fade (Fx.fadeStripText).
         The running fade animator + the last shown talk identity ride
         on each text view itself, so they die with the view and a
         steady 1s tick never re-animates a settled title/sub. -->
    <item name="stripTextAnim" type="id"/>
    <item name="stripTextLast" type="id"/>
    <!-- v14.22: tag key for the strip-photo crossfade (Fx.crossfadeStripPhoto).
         The running crossfade animator rides on the photo view itself,
         so it dies with the view and a steady 1s tick never re-animates
         a settled portrait. No last-name key: the activity's
         <field>StripPhotoName is the single record (see Fx). -->
    <item name="stripPhotoAnim" type="id"/>
</resources>
