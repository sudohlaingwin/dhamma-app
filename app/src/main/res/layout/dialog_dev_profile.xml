<?xml version="1.0" encoding="utf-8"?>
<!-- v13.56: Developer Profile pop-up — his photo as the background, name,
     and the real Facebook icon only (no text link). Tapping the icon opens
     his Facebook profile in the browser/Facebook app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">

    <ImageView
        android:id="@+id/devProfileBg"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:scaleType="centerCrop"
        android:src="@drawable/dev_profile_bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:background="@drawable/dev_profile_scrim" />

    <TextView
        android:id="@+id/devProfileClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="×"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Htay Hlaing Win"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Developer"
            android:textColor="#E8E8E8"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/devProfileFb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fb_circle"
            android:clickable="true"
            android:contentDescription="Facebook"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_facebook_f" />
    </LinearLayout>
</FrameLayout>
