<?xml version="1.0" encoding="utf-8"?>
<!-- v12.67: Home Screen Widget (premium backlog #4) — RemoteViews-safe
     views only (LinearLayout / TextView / ImageButton). 4x1 cells:
     app name, talk title + sayadaw, Play/Pause + Next. The whole
     body (wg_body) opens the Room; the two buttons talk to the
     service, never to an activity.
     v13.84 (large-font clip note, widget-audit-1346): paddingTop /
     paddingBottom 10dp -> 6dp. Content was ~112dp at default font
     vs minHeight 112dp, so Large (1.15x) overflowed 5.9dp and
     Largest (1.3x) 11.6dp, the icons surviving by 0.4dp only
     (sim1415.py, phone font k=1.362). Now 104.1dp at default,
     109.9dp at Large (fits), 115.6dp at Largest — only transparent
     button padding cut, icons clear by 8.4dp. Margins, text sizes,
     48dp buttons, minHeight and resizeMode untouched.
     v13.92 (slice 1084): the sounding sayadaw's portrait in the
     bottom row — the widget's own photo, the gold arc's last
     surface. The row is already 48dp tall, so a 48dp ring frame
     costs NO height (sim1415's 104.1/109.9/115.6dp stand); the
     cost is width: frame 48dp + 6dp gap + 3x48dp buttons leaves
     the sayadaw line 28dp at the 250dp minWidth (it ellipsizes;
     at a real ~360dp placement it keeps ~138dp). The frame owns
     visibility (GONE by default, so the picker preview shows no
     empty slot — the photo inside stays visible, the strips'
     v13.90 rule); the provider sets its background to the reused
     shelf_ring_playing drawable while sounding, nothing
     otherwise, and the 44dp photo sits centred 2dp inside the
     2dp stroke. No new drawable, no new colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="14dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/wg_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="တရားတော်"
        android:textSize="12sp"
        android:textColor="#E8C878"
        android:maxLines="1" />

    <TextView
        android:id="@+id/wg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="တရားတစ်ပုဒ် ရွေးပါ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- v13.92 (slice 1084): the sounding sayadaw's portrait.
             48dp ring frame (the strips' v13.90 form, reused
             shelf_ring_playing) around a centred 44dp photo — the
             frame owns visibility, GONE until the provider names a
             sayadaw, so the empty state and the picker preview show
             no hole. Tap falls through to wg_body (opens the Room);
             the photo carries no PendingIntent of its own. -->
        <FrameLayout
            android:id="@+id/wg_photo_ring"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wg_photo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:contentDescription="Sayadaw photo" />
        </FrameLayout>

        <TextView
            android:id="@+id/wg_sayadaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#CCFFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- v13.78 (slice 1070): Previous — the widget's transport
             row was Play/Pause + Next only; the Room, the notification
             card and headset/car all step back, the home screen could
             not. Same 48dp button as its neighbours; the sayadaw line
             (weight 1) absorbs the width. -->
        <ImageButton
            android:id="@+id/wg_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_prev"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Previous" />
        <ImageButton
            android:id="@+id/wg_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_play"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Play / Pause" />

        <ImageButton
            android:id="@+id/wg_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Next" />

    </LinearLayout>

        <!-- v15.94 (slice 2226): the widget's listened-progress bar — the thin gold line at the widget's bottom edge, the notification seek bar's shape on the home screen: 2dp tall with no top margin, the only size that keeps the Large fit (the height budget leaves 2.14dp). Gone by default, so the picker preview shows no bar; the empty state shows no bar either. -->
    <ProgressBar
        android:id="@+id/wg_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="#40C9A227"
        android:progressTint="#C9A227"
        android:visibility="gone" />

</LinearLayout>
