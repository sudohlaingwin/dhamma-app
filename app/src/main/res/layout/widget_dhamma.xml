<?xml version="1.0" encoding="utf-8"?>
<!-- v12.67: Home Screen Widget (premium backlog #4) — RemoteViews-safe
     views only (LinearLayout / TextView / ImageButton). 4x1 cells:
     app name, talk title + sayadaw, Play/Pause + Next. The whole
     body (wg_body) opens the Room; the two buttons talk to the
     service, never to an activity.
     v13.84 (large-font clip note, widget-audit-1346): paddingTop /
     paddingBottom 10dp -> 6dp. Content was ~112dp at default font
     vs minHeight 112dp, so Large (1.15x) overflowed 5.9dp and
     Largest (1.3x) 11.6dp, the icons surviving by 0.4dp only
     (sim1415.py, phone font k=1.362). Now 104.1dp at default,
     109.9dp at Large (fits), 115.6dp at Largest — only transparent
     button padding cut, icons clear by 8.4dp. Margins, text sizes,
     48dp buttons, minHeight and resizeMode untouched. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="14dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/wg_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="တရားတော်"
        android:textSize="12sp"
        android:textColor="#E8C878"
        android:maxLines="1" />

    <TextView
        android:id="@+id/wg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="တရားတစ်ပုဒ် ရွေးပါ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wg_sayadaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#CCFFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/wg_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_play"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Play / Pause" />

        <ImageButton
            android:id="@+id/wg_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Next" />

    </LinearLayout>

</LinearLayout>
