<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp">
        <!-- v15.30 (slice 1816): shared-element source — this photo
             grows into the Talks header portrait; the name must
             match talksHeaderPhoto in activity_talks.xml. -->
        <com.h2h.dhamma.CircleImageView
            android:id="@+id/photo"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:scaleType="centerCrop"
            android:transitionName="talksSayadawPhoto" />

        <!-- v15.33 (slice 1838): live EQ badge — the sounding card's
             mark, dancing while the talk sounds and resting while
             paused (EqBarsView, v15.29). A dark pill on the photo's
             bottom-right corner so the gold bars read on any photo,
             like the playing indicator on album art. GONE unless
             sounding; MainActivity getView owns the swap. -->
        <FrameLayout
            android:id="@+id/eqBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:background="@drawable/eq_badge_bg"
            android:padding="3dp"
            android:visibility="gone">
            <com.h2h.dhamma.EqBarsView
                android:id="@+id/eqBars"
                android:layout_width="20dp"
                android:layout_height="18dp" />
        </FrameLayout>

    </FrameLayout>
    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/ink"
        android:textSize="11sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="10sp" />
    <!-- v16.11 (slice 2360, C5): listened-progress hairline — the
         Talks-row line (v13.97) / Favourites-row line (v15.90) /
         rail-card line (v15.60) idiom, now under the card's group
         line: 3dp tall, faint-gold track #33C9A227 + solid-gold
         fill #C9A227 split by weight, weightSum 1. getView sets
         the fill/space weights from gridListenedFrac2360 on every
         bind and hides the track (GONE) when the fraction is 0
         or unknown, so a recycled card can never leak a bar onto
         another sayadaw. -->
    <LinearLayout
        android:id="@+id/progTrack"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="4dp"
        android:background="#33C9A227"
        android:orientation="horizontal"
        android:visibility="gone"
        android:weightSum="1">
        <View
            android:id="@+id/progFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="#C9A227" />
        <View
            android:id="@+id/progSpace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
