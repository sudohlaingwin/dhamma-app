<?xml version="1.0" encoding="utf-8"?>
<!-- v12.66: Listening history / stats (premium backlog #3) — total time, day streak and most-listened sayadaw as three gold stat cards on top, the recent talks beneath; tap a recent talk to play it. Rows are built in code (HistoryActivity), like the Playlist screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/hsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/maroon"
            android:textSize="20sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/hsClearBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_btn_dark"
            android:minWidth="0dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
            android:id="@+id/hsTotalValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#C9A227"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/hsTotalLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/hsStreakValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#C9A227"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/hsStreakLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/hsTopValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#C9A227"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/hsTopSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/hsTopLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/hsRecentLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/maroon"
        android:textSize="16sp"
        android:textStyle="bold" />
    <!-- v14.06 (F5, sixth pass slice 5): the empty text used to
         sit AFTER the weight-1 list, so it rendered at the very
         bottom of the screen. The FrameLayout centers it in the
         list area instead; ids unchanged, so HistoryActivity's
         manual visibility code works as before. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/hsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/hsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
    <!-- v13.54: real mini-player, the same strip as Talks' (v4.31) —
         GONE while nothing plays, so the history stays list-only. A
         recent talk that is playing (tap a recent talk) now shows
         here: tap opens its Room, ▶/⏸ works from here, live
         state always correct; a dead session with a saved spot
         shows the ↺ resume strip instead. -->
    <LinearLayout
        android:id="@+id/nowStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/nav_glass"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.h2h.dhamma.CircleImageView
                android:id="@+id/nowStripPhoto"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nowStripText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nowStripSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/nowStripPrev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripToggle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripNext"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/nowStripProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#40C9A227"
            android:progressTint="#C9A227" />
    </LinearLayout>
</LinearLayout>
