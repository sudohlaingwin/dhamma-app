<?xml version="1.0" encoding="utf-8"?>
<!-- v2.43 Liquid Glass: floating glass card. Outer padding makes the gap
     (ListView ignores item margins); inner card carries the glass. A talk
     row is its number, title and marks (v5.49: ▶/◈/★/⬇/⏳/✓/↺, same
     order as the Room drawer) — plus a v13.99 duration clock
     on the right edge. -->
<!-- v7.32: row ⋮ removed by user order — the row is number + title + marks only. -->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <!-- v15.96 (slice 2239): swipe underlay — the gold action strip the card reveals as it travels: queue-next on the left (a right drag), mark/un-mark on the right (a left drag). It sits behind the card (first child), fills the padded content box exactly like the card, and is invisible at rest — the opaque card covers it. Labels are painted from Lang at bind time, never hardcoded here. -->
    <LinearLayout
        android:id="@+id/talkSwipeUnder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dl_swipe_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/talkSwipeLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:textColor="#3B2314"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/talkSwipeRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:paddingEnd="20dp"
            android:textColor="#3B2314"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/cardInner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="10dp">
        <TextView
            android:id="@+id/index"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@color/gold"
            android:textSize="14sp" />
        <!-- v15.29 (slice 1813): the sounding row's EQ bars — the
             Spotify / YouTube Music / Apple Music now-playing
             indicator, in the 48dp number slot: the number hides
             while its talk sounds and the bars dance (TalksActivity
             getView owns the swap). GONE unless sounding. -->
        <com.h2h.dhamma.EqBarsView
            android:id="@+id/eqBars"
            android:layout_width="48dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/talkTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="15sp" />
            <!-- v13.97 (slice 1092): listened-progress hairline —
                 thin gold line under the title, fraction = resume
                 spot / total duration. The track is a translucent
                 gold wash so the scale reads in a still; the fill
                 is solid gold. GONE unless a half-heard talk
                 binds it (TalkAdapter.getView paints the weights). -->
            <LinearLayout
                android:id="@+id/hairTrack"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#33C9A227"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="1">
                <View
                    android:id="@+id/hairFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/gold" />
                <View
                    android:id="@+id/hairSpace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
        <!-- v13.99 (slice 1094): talk duration — the stored total
             length (Prefs.talkDurMap, v13.96) as a small muted clock
             on the row's right edge, so a listener can judge "do I
             have time for this one" without opening it. GONE unless
             a duration was ever stored; TalkAdapter.getView paints
             it, reset on every bind. -->
        <TextView
            android:id="@+id/talkDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />
        <!-- v7.32 (user order 2026-11-01 ~19:36 +07): row ⋮ removed — rows are tap-to-open + long-press-share only again. -->
    </LinearLayout>
</FrameLayout>
