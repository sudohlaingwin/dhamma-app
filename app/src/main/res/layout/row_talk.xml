<?xml version="1.0" encoding="utf-8"?>
<!-- v2.43 Liquid Glass: floating glass card. Outer padding makes the gap
     (ListView ignores item margins); inner card carries the glass. A talk
     row is its number, title and marks (v5.49: ▶/◈/★/⬇/⏳/✓/↺, same
     order as the Room drawer) — plus a v13.99 duration clock
     on the right edge. -->
<!-- v7.32: row ⋮ removed by user order — the row is number + title + marks only. -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <LinearLayout
        android:id="@+id/cardInner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="10dp">
        <TextView
            android:id="@+id/index"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@color/gold"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/talkTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="15sp" />
            <!-- v13.97 (slice 1092): listened-progress hairline —
                 thin gold line under the title, fraction = resume
                 spot / total duration. The track is a translucent
                 gold wash so the scale reads in a still; the fill
                 is solid gold. GONE unless a half-heard talk
                 binds it (TalkAdapter.getView paints the weights). -->
            <LinearLayout
                android:id="@+id/hairTrack"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#33C9A227"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="1">
                <View
                    android:id="@+id/hairFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/gold" />
                <View
                    android:id="@+id/hairSpace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
        <!-- v13.99 (slice 1094): talk duration — the stored total
             length (Prefs.talkDurMap, v13.96) as a small muted clock
             on the row's right edge, so a listener can judge "do I
             have time for this one" without opening it. GONE unless
             a duration was ever stored; TalkAdapter.getView paints
             it, reset on every bind. -->
        <TextView
            android:id="@+id/talkDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />
        <!-- v7.32 (user order 2026-11-01 ~19:36 +07): row ⋮ removed — rows are tap-to-open + long-press-share only again. -->
    </LinearLayout>
</LinearLayout>
