<?xml version="1.0" encoding="utf-8"?>
<!-- v9.01 (user order 2026-11-02 ~20:08 +07): custom notification content view —
     collapsed card carries its own buttons + tap-seek zones, so play/pause/next
     work straight from the shade without expanding, and tapping the blue bar
     jumps to that fraction of the talk. NOT MediaStyle (banned: v1.70/v5.25/v5.26
     vanished on his phone) — this is a plain RemoteViews layout on the same
     channel, so the card that already shows stays the card that shows.
     Seek is TAP zones (20), not drag: RemoteViews cannot host a SeekBar or
     report a drag position, so each zone seeks to its own fraction.
     v10.95: transport glyphs are dark ink #3B2314 like the title, not white —
     the card background is translucent-white nav_glass, so white glyphs
     were invisible on a light shade (same bug class as the v10.94 strips). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nav_glass"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/notifPhoto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/notifTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#3B2314"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/notifSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#6B543A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp">
        <ProgressBar
            android:id="@+id/notifSeekBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="center_vertical"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#40C9A227"
            android:progressTint="#C9A227" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView android:id="@+id/notifSeek0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            <TextView android:id="@+id/notifSeek19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/notifPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="⏮"
            android:textColor="#3B2314"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/notifToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="⏸&#xFE0E;"
            android:textColor="#3B2314"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/notifNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="⏭"
            android:textColor="#3B2314"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
