<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <!-- v15.97 (slice 2246): swipe underlay — the gold action strip the card reveals as it travels: remove-from-queue on the left (a right drag), mark/un-mark on the right (a left drag). It sits behind the card (first child), fills the card's box exactly — the same 3dp top/bottom margins the card carries, so no gold peeks at rest — and is invisible at rest, the opaque card covering it. Labels are painted from the language table at bind time, never hardcoded here. -->
    <LinearLayout
        android:id="@+id/roomSwipeUnder46"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/dl_swipe_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/roomSwipeLeft46"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:textColor="#3B2314"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/roomSwipeRight46"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:paddingEnd="20dp"
            android:textColor="#3B2314"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rowCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/drawer_row"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="10dp">
        <TextView
            android:id="@+id/index"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@color/gold"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/talkTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="15sp" />
            <!-- v13.98 (slice 1093): listened-progress hairline —
                 thin gold line under the title, fraction = resume
                 spot / total duration. Same track as the chooser
                 and library rows (v13.97): the fill is solid gold
                 over a translucent wash so the scale reads in a
                 still. GONE unless a half-heard talk binds it
                 (TalkAdapter.getView paints the weights). -->
            <LinearLayout
                android:id="@+id/hairTrack"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#33C9A227"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="1">
                <View
                    android:id="@+id/hairFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/gold" />
                <View
                    android:id="@+id/hairSpace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
        <!-- v14.00 (slice 1095): talk duration — the stored total
             length (drawerDurCache, v13.96) as a small muted clock
             on the row's right edge, mirroring the chooser clock
             (v13.99). Fixed #AAAAAA: the drawer is a dark glass
             surface in both themes, so the day/night muted pair
             would be too dark here. GONE unless a duration was
             ever stored; TalkAdapter.getView paints it, reset on
             every bind. -->
        <TextView
            android:id="@+id/talkDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:visibility="gone" />
        <!-- v13.73 (slice 1061): visible queue-move grip — gold ↕ at the
             right edge of waiting queue rows in the queue-only drawer view.
             Tap picks the talk up for a pick-up/drop move; hidden everywhere
             else (default gone; the adapter bind shows it only where it
             applies). 44dp wide so the target is thumb-sized. -->
        <TextView
            android:id="@+id/moveGrip"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:text="↕"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
