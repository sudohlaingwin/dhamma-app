<?xml version="1.0" encoding="utf-8"?>
<!-- v12.95: in-app updater block (3D-app force-update system) — full-screen
     dialog content. Texts are set from Lang (upd_* keys) at show time;
     the Burmese below is the design-time placeholder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1E140E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">
    <TextView
        android:id="@+id/updTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update အသစ်ရှိတယ်"
        android:textColor="#C9A227"
        android:textSize="24sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/updSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="App အသစ်ထွက်နေပြီ။ Update လုပ်ပြီးမှ ဆက်သုံးလို့ရမယ်။"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/updVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textColor="#C9A227"
        android:textSize="15sp"
        android:textStyle="bold" />
    <ProgressBar
        android:id="@+id/updBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#C9A227"
        android:visibility="invisible" />
    <TextView
        android:id="@+id/updStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
    <Button
        android:id="@+id/updBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/glass_btn"
        android:text="Update လုပ်မယ်"
        android:textColor="#C9A227"
        android:textSize="18sp"
        android:textStyle="bold" />
    <!-- v13.10 (F2): the escape hatch — a quiet text button, hidden
         until the update is actually stuck (failed download, refused
         install permission, or installer cancelled). Tapping it keeps
         this version for the rest of this process; the next cold start
         asks again. -->
    <Button
        android:id="@+id/updSkip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:text="ဒီဗားရှင်းနဲ့ပဲ ဆက်သုံးမယ်"
        android:textColor="#AAAAAA"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
