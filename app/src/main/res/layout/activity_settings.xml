<?xml version="1.0" encoding="utf-8"?>
<!-- v13.02 (user order 2026-11-07 ~22:34 +07, UI gloss pass): the 5 section
     headers read gold now (was muted grey) — flat switch-row shape untouched. -->
<!-- v12.94 (user order 2026-11-06 ~22:46 +07: rebuilt to the worldwide
     music-streaming-app standard — flat sections with small headers,
     Switch rows, value/nav rows with hairline dividers; the 6 cards,
     the wall of raised buttons, the big Back button, the long note
     paragraphs, the duplicate source credit and 2 of the 3 clear
     buttons are gone; every function stays, only the shape changed).
     v3.76: Settings regrouped per user order 2026-10-30 ~22:24 +07 — Theme card
     and Speed card REMOVED (day/night lives on Main; speed is not needed);
     Language card added (font / language / playback / history / downloads).
     v9.11 (user order 2026-11-02 ~21:12 +07): font + language cards are ONE row
     each (label + current value + ›) opening a single-choice dialog — the
     12 inline language buttons + 3 font buttons were the clutter he named. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">
<ScrollView
