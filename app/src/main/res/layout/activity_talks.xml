<?xml version="1.0" encoding="utf-8"?>
<!-- v1.51: Talks is ONLY a list for choosing a talk — no buttons, no
     filters, nothing else. Tapping a row opens it in the Room.
     (Retry appears only when loading fails; progress only while loading.
     v4.93: a title search box sits under the title — see talkSearchRow.) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <!-- v6.04: chooser header portrait — the album-art mirror of the
         Room sayadaw row (v5.38) and the four strip portraits
         (v6.00–v6.03): the chooser header was the last now-playing
         surface naming a sayadaw with text alone. -->
    <LinearLayout
        android:id="@+id/talksHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- v13.89 (slice 1081): chooser header photo gold ring —
             the 56dp portrait now sits in a 60dp frame whose
             background is the shelf ring drawable (reused, no new
             drawable) while a talk in this list sounds, so the
             sounding sayadaw reads in a still screenshot. Same
             4dp geometry as the Room header's 52/48dp frame
             (v13.88) and the shelf's 56/52dp chip (v13.87); the
             12dp gap moved to the frame, so the row spacing is
             unchanged and the photo never moves or shrinks. -->
        <FrameLayout
            android:id="@+id/talksHeaderPhotoRing"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp">
            <com.h2h.dhamma.CircleImageView
                android:id="@+id/talksHeaderPhoto"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:transitionName="talksSayadawPhoto" />
        </FrameLayout>
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/maroon"
            android:textSize="20sp"
            android:textStyle="bold" />
        <!-- v15.45 (slice 1939): header star — the
             sayadaw-favourite toggle for this screen: 48dp,
             22sp glyph, gold while this sayadaw is
             favourited, muted while not. This is NOT the
             v6.07 download-all below — that button is
             banned and stays gone; this star favourites
             the sayadaw, which no Talks surface could do
             before (Main's grid long-press was the only
             entry). -->
        <TextView
            android:id="@+id/talkFavBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="☆"
            android:textColor="@color/muted"
            android:textSize="22sp" />
        <!-- v15.45 (slice 1941): header info — the info glyph
             at the header row's end beside the star, opening
             the sayadaw info sheet (name, group, total talks,
             new talks). 48dp, 22sp glyph, borderless, muted
             like the star; GONE until a list lands, painted
             by paintTalkInfoBtn. This is NOT a favourite
             control and NOT the v6.07 download-all below. -->
        <TextView
            android:id="@+id/talkInfoBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="ⓘ"
            android:textColor="@color/muted"
            android:textSize="22sp"
            android:visibility="gone" />
        <!-- v15.53 (slice 1980): header share — the
             sayadaw-share verb for this screen: 48dp,
             22sp glyph, borderless, muted like the star
             and the info glyph; GONE until a list lands
             and the sayadaw has a page (paintTalkShareBtn).
             The Room header long-press (v4.16) shares the
             same text, but a hidden gesture is not a
             visible verb — this button is the chooser's
             first share. NOT the banned v6.07 download-all
             below — this shares the page link, it never
             downloads anything. -->
        <TextView
            android:id="@+id/talkShareBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="↗"
            android:textColor="@color/muted"
            android:textSize="22sp"
            android:visibility="gone" />
        <!-- v6.07: header download-all — the chooser could queue a
             whole sayadaw in one tap (v4.49–v4.52 bulk queue verbs)
             but downloading one meant opening each talk in the Room
             for its strip ⬇; this is the album-download mirror.
             GONE until a list lands, like the search row below, so
             loading/empty states stay exactly as before. -->
    </LinearLayout>
    <!-- v4.93: talk search — a sayadaw's list can run long, and
         browsing it meant scrolling the whole list to find one
         title; Main already searches sayadaws, the chooser never
         searched its own talks. GONE until a list lands, so the
         loading/empty states stay exactly as before. -->
    <LinearLayout
        android:id="@+id/talkSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <EditText
            android:id="@+id/talkSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/search_bg"
            android:hint="တရားခေါင်းစဉ် ရှာပါ…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />
        <!-- v5.57: talkSearchClear carries glass_icon_3d (was transparent) —
             same visual-system completion as the nav icons (v5.56): the
             chooser's ✕ was the last ✕ control without a badge. -->
        <TextView
            android:id="@+id/talkSearchClear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/glass_icon_3d"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:visibility="gone" />
        <!-- v13.95 (slice 1090): the cycling filter button lived
             here; the four filter chips below replace it (same
             four modes, same Lang keys) — one tap each, and
             the active mode reads at a glance. -->
    </LinearLayout>
    <!-- v13.95 (slice 1090): chooser filter chips — the four
         filter views (v4.94 all / ★ only / unlistened only,
         v5.13 downloaded only) lived behind one cycling button in
         the search row: undiscoverable, and the active mode showed
         only as that button's label. Four direct chips now (All /
         ★ / New / Downloaded), same modes, same Lang keys the
         button already used (repeat_all / filter_btn_star /
         filter_btn_new / filter_btn_dl); the layout texts are the
         shipped Burmese values, asserted by the patch. GONE until
         a list lands, like the search row above. -->
    <LinearLayout
        android:id="@+id/talkFilterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/chipTalkAll"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="အားလုံး"
            android:textColor="@color/muted"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/chipTalkStar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="★ သာ"
            android:textColor="@color/muted"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/chipTalkNew"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="အသစ်သာ"
            android:textColor="@color/muted"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/chipTalkDl"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⬇ သာ"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
    <!-- v13.76 (slice 1068): chooser Play All — the shown talks had
         no one-tap play: a row tap plays one talk only, and "queue
         all from here" (v13.04) queues without starting, hidden in
         a long-press dialog. Button under the search row
         (Downloaded's btnDlPlayAll shape; v13.93: half-width in a row
         with Shuffle), GONE until a list lands
         like the search row; the label is the shipped Burmese value
         of pl_play_all, asserted by the patch. -->
    <!-- v13.93 (slice 1088: Shuffle joins Play All in one row —
         the chooser had no shuffle play at all (the library's is a
         hidden long-press on its Play All, v4.16, and the Room shuffle
         toggle only steers auto-advance). Two equal-weight buttons
         (Downloaded's dlBtnRow shape); the row owns the GONE-until-
         a-list-lands gate, so both buttons share it. -->
    <LinearLayout
        android:id="@+id/talkPlayRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <Button
            android:id="@+id/btnTalkPlayAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ အားလုံးဖွင့်မယ်" />
        <Button
            android:id="@+id/btnTalkShuffle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="🔀 ကျပန်း ဖွင့်ခြင်း" />
        <!-- v15.43 (slice 1931): list sort — a 48dp "↕" beside Play All / Shuffle (the 1926 ● button's shape:
             borderless selectable background, centred, @color/muted default); gold while oldest-first is on.
             Shares the Play row's GONE-until-a-list-lands gate. -->
        <Button
            android:id="@+id/btnTalkSort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="↕"
            android:textColor="@color/muted" />
    </LinearLayout>
    <!-- v15.44 (slice 1933): "Play new" — one tap queues +
         plays only this sayadaw's new (●-dotted) talks, in
         shown order. GONE until a list lands AND such talks
         exist; hidden while a search or filter narrows the
         list. The verb is Lang.java's own attested tokens
         ("new" + "play", extracted by the patch, never
         hand-typed); the count ("N <word>") is set in code
         from queue_added_suffix's own word. nav_glass is
         reused, no new drawable. -->
    <LinearLayout
        android:id="@+id/talkPlayNewRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/nav_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/talkPlayNewLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ အသစ် ဖွင့်မယ်"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/talkPlayNewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="15sp" />
    </LinearLayout>
    <!-- v15.43 (slice 1932): "Continue listening" — the one-tap
         return to this sayadaw's in-progress talk (saved spot
         over 5s, not finished, not the sounding talk). GONE until
         a list lands AND such a talk exists; hidden while a
         search or filter narrows the list. The verb is the
         resume_from Lang string's own Burmese; the title + time
         are set in code. nav_glass is reused, no new drawable. -->
    <LinearLayout
        android:id="@+id/talkContinueRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/nav_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/talkContinueLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↺ ဆက်နားထောင်ရန်"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/talkContinueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="15sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/talkSearchEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="ရှာတာမတွေ့ပါ — တခြားစာလုံးနဲ့ ပြန်ရှာကြည့်ပါ"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp" />
    <Button
        android:id="@+id/btnRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="↻ ပြန်ဆွဲထုတ်မယ်"
        android:visibility="gone" />
    <!-- v15.34 (slice 1841): pull-to-refresh header — 0dp + GONE
         until a downward pull at the top of the list grows it (see
         TalksActivity pullOnTouch); the label reuses the retry
         button's own text, no new strings; the small spinner is
         gold like the strip progress. -->
    <LinearLayout
        android:id="@+id/pullRefreshHeader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/pullRefreshSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@color/gold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/pullRefreshLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ ပြန်ဆွဲထုတ်မယ်"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
    <!-- v15.45 (slice 1940): back-to-top frame — the list now
         sits in a FrameLayout so a floating gold ↑ can ride
         over its bottom-end corner: the title tap (v4.12)
         already jumps to the top, but the title is off-screen
         exactly when the jump is needed. The frame carries the
         old ListView geometry (8dp top margin, weight 1) so
         the list itself does not move; the button is GONE
         until the list has scrolled past eight rows. -->
    <FrameLayout
        android:id="@+id/talkListFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/surface"
            android:dividerHeight="1dp"
            android:fastScrollEnabled="true" />
        <!-- v15.55 (slice 1994): jump-to-playing button — the
             floating gold ▶ stacked above the ↑ (same 56dp oval,
             same maroon glyph, 16dp off the corner): the title
             long-press (v4.15) already jumps to the playing talk,
             but the gesture is hidden and the title is off-screen
             exactly when the jump is needed — the same visible,
             reachable-form class as the 1940 back-to-top button.
             GONE until a live session plays this sayadaw's talk
             AND that talk's row has scrolled off-screen. -->
        <TextView
            android:id="@+id/talkPlayingBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="88dp"
            android:background="@drawable/top_btn_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="@color/maroon"
            android:textSize="24sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/talkTopBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/top_btn_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="↑"
            android:textColor="@color/maroon"
            android:textSize="24sp"
            android:visibility="gone" />
    </FrameLayout>
    <!-- v7.32 (user order 2026-11-01 ~19:36 +07): queue preview removed — no preview block above the strip. -->
    <!-- v4.31: real mini-player, same strip as Main's (v4.15/v4.30) —
         GONE while nothing plays, so the list-only chooser stays
         list-only; rows themselves stay number + title only. -->
    <LinearLayout
        android:id="@+id/nowStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/nav_glass"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- v13.90 (slice 1082): strip portrait sounding gold ring —
                 the 44dp portrait now sits in a 48dp frame whose
                 background is the shelf ring drawable (reused, no new
                 drawable) while a live session sounds, so the sounding
                 sayadaw reads in a still screenshot on every strip.
                 Same 4dp geometry as the Room header's 52/48dp frame
                 (v13.88) and the chooser header's 60/56dp frame
                 (v13.89); the 10dp gap moved to the frame, so the row
                 spacing is unchanged and the photo never moves or
                 shrinks. The frame owns visibility now (gone when no
                 sayadaw is recorded); the ring is off in resume mode
                 (nothing sounds) and while a talk has ended. -->
            <FrameLayout
                android:id="@+id/nowStripPhotoRing"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone">
                <com.h2h.dhamma.CircleImageView
                    android:id="@+id/nowStripPhoto"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:transitionName="roomSayadawPhoto" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nowStripText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nowStripSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">
            <TextView
                android:id="@+id/nowStripPrev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripToggle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripNext"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            
            
            
            </LinearLayout>
        
        <ProgressBar
            android:id="@+id/nowStripProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#40C9A227"
            android:progressTint="#C9A227" />
    </LinearLayout>
</LinearLayout>
