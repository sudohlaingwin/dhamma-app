<?xml version="1.0" encoding="utf-8"?>
<!-- v15.44 (slice 1936): the Main grid's list row — the photo
     card's horizontal twin. Same view ids (photo / name / group /
     eqBadge / eqBars) so MainActivity getView binds it untouched;
     the name reads larger (13sp, one line) and the group sits
     beside it, for listeners who want the full name at a glance.
     The photo keeps the talksSayadawPhoto transition name, so the
     shared-element flight to Talks runs from either shape. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">
        <com.h2h.dhamma.CircleImageView
            android:id="@+id/photo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:transitionName="talksSayadawPhoto" />
        <FrameLayout
            android:id="@+id/eqBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:background="@drawable/eq_badge_bg"
            android:padding="3dp"
            android:visibility="gone">
            <com.h2h.dhamma.EqBarsView
                android:id="@+id/eqBars"
                android:layout_width="20dp"
                android:layout_height="18dp" />
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
