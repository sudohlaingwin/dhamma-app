<?xml version="1.0" encoding="utf-8"?>
<!-- v15.45 (slice 1941): sayadaw info sheet — the about card
     for the sayadaw whose talks this screen lists: photo, name,
     tradition/group, total talks, the new-talk count, the
     original-page link, and the home-screen shortcut. The
     counts deliberately do NOT repeat the header title's
     downloaded/finished/half-heard counts — the sheet shows
     only what no surface shows. Shown through the app's
     standard AlertDialog.Builder (v15.29 entrance); the
     positive button is the shipped dlg_close key. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.h2h.dhamma.CircleImageView
        android:id="@+id/infoPhoto"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/infoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/maroon"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/infoGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/infoTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/infoNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <!-- v15.46 (slice 1943): the original-page link — a gold
         tappable row under the counts; GONE while this sayadaw
         has no page URL (the sheet's own gate, see
         SayadawInfo.showPageRow). The label is the new
         open_orig_page key; the globe is set in code beside it. -->
    <TextView
        android:id="@+id/infoPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textSize="16sp" />

    <!-- v15.46 (slice 1945): the home-screen shortcut — a gold
         tappable row under the original-page row; GONE while
         pinning is impossible on this device, while the
         sayadaw has no page URL, or while already pinned
         (the HomeShortcut gate). The label is the new
         menu_add_home key; the house glyph is set in code. -->
    <TextView
        android:id="@+id/infoHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textSize="16sp" />

</LinearLayout>
