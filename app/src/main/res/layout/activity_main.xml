<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="☸ တရားတော်"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="@color/maroon"
            android:textSize="28sp"
            android:textStyle="bold" />
        <!-- v5.55: themeToggle carries glass_icon_3d (was flat circle_gold) —
             the last interactive control on Main without the Liquid Glass
             language (Room v5.51, strips v5.52, row menus v5.53, grid star
             v5.54). 48dp size, glyph and click/long-press wiring untouched;
             the drawable's own shadow layer gives the depth, no elevation
             needed in the static header. -->
        <Button
            android:id="@+id/themeToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/glass_icon_3d"
            android:text="🌙"
            android:contentDescription="နေ့/ည ပြောင်းရန်"
            android:textColor="@color/maroon"
            android:textSize="20sp" />
    </RelativeLayout>
    <!-- v13.82 (slice 1074): ★ favourites-filter button — the
         favourites-only filter lived behind a hidden gesture (long-press
         an empty search, v4.19): the only visible trace was the ★ prefix
         on the search hint. A 48dp gold ★ beside the search field makes
         it a direct tap, the Main mirror of the library's v13.75 filter
         chips. The field keeps its look (same background, hint, padding,
         text size); the row carries the 12dp top margin now. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/search_bg"
            android:hint="Search..."
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />
        <!-- v15.33 (slice 1836): search clear ✕ — Main never had a clear button (v4.17: clearing meant a hidden long-press or letter-by-letter delete) while the Talks chooser (talkSearchClear, v5.57) and the Library (btnClearDlSearch, v2.41) both carry one. The ✕ mirrors the chooser's control exactly — same 48dp, same glass_icon_3d badge, same gold ✕ — and fades in/out with the query (refreshSearchClear in MainActivity), morphing on tap (Fx.morph, the v15.28 chooser idiom). -->
        <TextView
            android:id="@+id/searchClear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/glass_icon_3d"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/favFilterBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="★"
            android:textColor="@color/muted"
            android:textSize="22sp" />
        <!-- v15.42 (slice 1926): ● new-only filter button — the ★
             button's twin beside it: same 48dp, same borderless
             background, same 22sp glyph. Tapping narrows the grid
             to sayadaws with unseen new talks (the 1921 dot set);
             gold while the filter is on, muted while off. -->
        <TextView
            android:id="@+id/newFilterBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="●"
            android:textColor="@color/muted"
            android:textSize="22sp" />
    </LinearLayout>
    <!-- v13.74 (slice 1065): ★ favourites shelf — the ★ set (long-press a
         card to star; drives Wi-Fi auto-download) had no visible home on
         Main: the only way back to a starred sayadaw was scrolling the
         full grid or the hidden search-long-press filter. A horizontal
         shelf of starred portraits above the grid, shown only while
         favourites exist and no search/filter is active; empty state
         leaves Main exactly as before. Label is Burmese chrome like
         the app title above (titleText is hardcoded Burmese too). -->
    <LinearLayout
        android:id="@+id/favShelfWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ အကြိုက်ဆုံး ဆရာတော်များ"
            android:textColor="@color/gold"
            android:textSize="14sp"
            android:textStyle="bold" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/favShelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
    <!-- v15.33 (slice 1835): empty-search view — a search matching no sayadaw used to leave a blank grid with only a transient toast (slice 1830); every streaming app names the empty state in place. The line sits centred over the grid area (FrameLayout wrap, grid id + geometry untouched) and fades in/out with the filter (refreshNoResults in MainActivity); text comes from Lang (sayadaw_not_found / _fav), never hardcoded. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">
        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fastScrollEnabled="true"
            android:horizontalSpacing="12dp"
            android:numColumns="4"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp" />
        <TextView
            android:id="@+id/noResultsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/muted"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout
        android:id="@+id/nowStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/nav_glass"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- v13.90 (slice 1082): strip portrait sounding gold ring —
                 the 44dp portrait now sits in a 48dp frame whose
                 background is the shelf ring drawable (reused, no new
                 drawable) while a live session sounds, so the sounding
                 sayadaw reads in a still screenshot on every strip.
                 Same 4dp geometry as the Room header's 52/48dp frame
                 (v13.88) and the chooser header's 60/56dp frame
                 (v13.89); the 10dp gap moved to the frame, so the row
                 spacing is unchanged and the photo never moves or
                 shrinks. The frame owns visibility now (gone when no
                 sayadaw is recorded); the ring is off in resume mode
                 (nothing sounds) and while a talk has ended. -->
            <FrameLayout
                android:id="@+id/nowStripPhotoRing"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone">
                <com.h2h.dhamma.CircleImageView
                    android:id="@+id/nowStripPhoto"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:transitionName="roomSayadawPhoto" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nowStripText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nowStripSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">
            <TextView
                android:id="@+id/nowStripPrev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripToggle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripNext"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            
            
            
            </LinearLayout>
        
        <ProgressBar
            android:id="@+id/nowStripProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#40C9A227"
            android:progressTint="#C9A227" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nav_glass"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="6dp">
        <LinearLayout
            android:id="@+id/navMainItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <!-- v9.08 (user order 2026-11-02 ~20:59 +07): nav glass circles REMOVED —
                 his circled screenshot asked for the badges off the nav icons
                 (the strip circles went in v9.07; these are the nav ones he meant).
                 Icons keep their glyphs/sizes; code still sets their colours. -->
            <TextView
                android:id="@+id/navMainIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="🏠"
                android:textColor="@color/gold"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navMainLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ပင်မ"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navPlayerItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/navPlayerIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="▶"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navPlayerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mp3 Player"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navSettingsItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/navSettingsIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="⚙"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ဆက်တင်"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
