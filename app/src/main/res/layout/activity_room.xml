<?xml version="1.0" encoding="utf-8"?>
<!-- v5.30 (user order 2026-10-31 ~21:05 +07, Spotify now-playing
     video): Room panel is Spotify-structured — big talk title first,
     sayadaw name below it, taller wave, clean elapsed/total times
     row, main control row Shuffle | Previous | Play | Next |
     Sleep(timer), secondary row Forward | Speed | Download |
     Favourite | Share | Repeat. All buttons are the existing
     ones, only reordered; no new ids, no new wiring. The talk
     list stays in the right side drawer opened by the top-right
     "Play List" button. The altar stays visible behind the
     translucent panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E140E">
    <com.h2h.dhamma.RoomView
        android:id="@+id/roomView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- v12.52: id so RoomView can read this panel's real top for
         the theme-scene flame limit (Finding 6) — the panel is
         wrap_content, so its top is not a fixed fraction of the
         view on shorter screens. -->
    <LinearLayout
        android:id="@+id/roomBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_panel"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="16dp">
            
            
            <!-- v7.28 (user order 2026-11-01 ~19:07 +07): sayadaw photo +
                 name on TOP, talk title BELOW it and smaller — the reverse
                 of the v5.30 Spotify order. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
            <!-- v13.88 (slice 1080): the header photo's ring frame —
                 52dp around the 48dp portrait, so the reused
                 shelf ring (2dp gold oval, 1dp inset) hugs the
                 photo exactly like the shelf chip (56/52dp). The
                 frame's background is the ring while this Room's
                 talk sounds, nothing otherwise; the photo itself
                 never moves or shrinks, and the margin lives on
                 the frame now. -->
            <FrameLayout
                android:id="@+id/roomSayadawPhotoRing"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:id="@+id/roomSayadawPhoto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:transitionName="roomSayadawPhoto" />
            </FrameLayout>
                <TextView
                    android:id="@+id/roomSayadaw"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#C9A227"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/roomNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="တရားတစ်ပုဒ် ရွေးပါ"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <!-- v15.99 (slice 2260): Up Next line — the next talk's title under
                 the now-playing line, the drawer header's Up Next (second line of
                 roomPlayListTitle) restated on the main screen: the listener sees
                 what plays next without opening the drawer. GONE until a next talk
                 resolves (single-talk list, no current talk, empty list); one line,
                 ellipsised, same secondary treatment as the sleep line (13sp #AAAAAA).
                 Display-only — ⏭ is the skip. -->
            <TextView
                android:id="@+id/roomUpNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:visibility="gone" />
            <!-- v1.42: retry, shown only when the talk list fails to load -->
            <Button
                android:id="@+id/roomRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="↻ ပြန်ဆွဲထုတ်မယ်"
                android:visibility="gone"
                android:background="@drawable/glass_btn_dark"
                android:textColor="#FFFFFF" />
            <LinearLayout
                android:id="@+id/roomSeekRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">
                <com.h2h.dhamma.WaveSeekView
                    android:id="@+id/roomSeek"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/roomElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#AAAAAA" />
                    
                    
                    
                    
                    
                    
                    
                    
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/roomSleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:visibility="gone" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/roomTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#AAAAAA" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/roomControlsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">
                <!-- v5.30: Spotify main row — Shuffle | Previous | Play (big) | Next | Sleep(timer). -->
<ImageButton
                        android:id="@+id/roomShuffleBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/glass_icon_3d"
                        android:contentDescription="Shuffle"
                        android:padding="10dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_shuffle"
                        android:elevation="6dp" />
<!-- v5.15: Previous talk in the time row — the Room had
                         Next in the control row but Previous only as the
                         hidden altar swipe-right; this is the visible way
                         back, without touching the 3-button control row. -->
                    <ImageButton
                        android:id="@+id/roomPrev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/glass_icon_3d"
                        android:contentDescription="Previous"
                        android:padding="10dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_prev"
                        android:elevation="6dp" />
<FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp">
                    <View
                        android:id="@+id/playGlow"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glow_ring"
                        android:visibility="gone" />
                    <!-- v15.94 (slice 2225): the gold progress arc around the Room play button — the thin gold arc that sweeps around the play control as the talk plays, so a glance says how far through the talk. The view paints nothing but its own track and arc; the poll drives it change-only, and it stays gone until a talk has a duration. -->
                    <com.h2h.dhamma.PlayRingView
                        android:id="@+id/playRing"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                    <ImageButton
                        android:id="@+id/roomPlayPause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/glass_icon_3d"
                        android:contentDescription="Play / Pause"
                        android:padding="14dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_play"
                        android:elevation="6dp" />
                </FrameLayout>
<ImageButton
                    android:id="@+id/roomNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/glass_icon_3d"
                    android:contentDescription="Next"
                    android:padding="10dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_next"
                    android:elevation="6dp" />
<!-- v5.17: Sleep timer beside Previous — the Room had
                         no way to ARM a timer: the countdown text only
                         exists while a timer runs, and the stack sleep
                         button died with the v5.11 stack removal, so
                         setting one meant leaving the player. Same
                         13sp glass style as Rewind/Previous; the
                         control row and the left stack stay untouched. -->
                    <ImageButton
                        android:id="@+id/roomSleepBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/glass_icon_3d"
                        android:contentDescription="Sleep timer"
                        android:padding="10dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_sleep"
                        android:elevation="6dp" />
            </LinearLayout>
            
            <!-- 2026-10-31 user order: Room Up Next strip + queue preview removed; queue stays in the Play List drawer. -->

        </LinearLayout>
    </LinearLayout>
    <!-- v2.48: Play List side drawer — slides in from the right, thin
         1dp gold rim, Liquid Glass over the altar photo. -->
    <LinearLayout
        android:id="@+id/roomPlayListPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/drawer_panel_3d"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/roomPlayListClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/glass_btn"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:elevation="4dp" />
            <TextView
                android:id="@+id/roomPlayListTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Play List"
                android:textColor="#C9A227"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <View
            android:id="@+id/roomPlayListDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#66C9A227" />
        <!-- v13.72 (slice 1058): queue bar — the queue-only view (reorder /
             play-next / remove) had no live entry point: its only writer
             was the never-wired mini-player ◈ button, and the 2026-11-01
             removals ban re-adding strip buttons, so the queue was
             reachable only via header long-press → clear dialog →
             "view queue only" (v7.78). This bar lives INSIDE the drawer
             (no strip button, no row menu, no drawer search): the ◈
             toggle shows the waiting count and enters the queue-only
             view; in queue-only view it exits to the full list and the
             ✕ button clears the queue (same dialog as the header
             long-press, minus the now-meaningless "view queue only").
             The ✓ button (v15.46, slice 1946) removes the finished
             talks only, and shows only while one waits. -->
        <LinearLayout
            android:id="@+id/roomQueueBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/roomQueueToggle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/glass_btn_dark"
                android:textColor="#C9A227"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/roomQueuePlAdd"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/glass_btn_dark"
                android:textColor="#C9A227"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/roomQueueClean"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/glass_btn_dark"
                android:textColor="#C9A227"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <Button
                android:id="@+id/roomQueueClear"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/glass_btn_dark"
                android:textColor="#C9A227"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        
        <!-- v15.99 (slice 2259): back-to-top button — the floating gold up-arrow at the drawer's bottom-end corner (the Talks 1940 / Downloaded 2003 / Bookmarks 2110 shape verbatim: same 56dp oval, same maroon glyph, 16dp off the corner): the header tap (v4.13) already jumps to the top, but v12.93 removed it — an accidental tap must never change state — and the header is off-screen exactly when the jump is needed. GONE until the list has scrolled past eight rows. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ListView
                android:id="@+id/roomList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:fastScrollEnabled="true" />
            <TextView
                android:id="@+id/roomTopBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/top_btn_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="↑"
                android:textColor="@color/maroon"
                android:textSize="24sp"
                android:visibility="gone" />
        </FrameLayout>
        <!-- v12.92 (user order 2026-11-06 ~21:32 +07: drawer bottom "ရုပ်ဆိုးနေတယ်"): a finished bottom edge — gold divider, centre handle, and a full-width glass close button, so the list ends cleanly instead of running off the screen edge. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#66C9A227" />
        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_handle" />
        <Button
            android:id="@+id/roomPlayListCloseBottom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_btn_dark"
            android:textColor="#C9A227"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
    <!-- USER ORDER 2026-10-31 ~19:39 +07: the entire left transport stack
     (repeat/shuffle/speed/sleep/download/favourite/share/previous/
     queue/copy-link/library/settings/home) was REMOVED here. The Room
     is clean again. Do NOT re-add stack buttons to this layout.
     Those functions stay reachable from mini-player strips, the
     drawer, and Settings. -->
    <!-- 3.72: Play List toggle, top-right corner, above the drawer so
         it stays tappable while the drawer is open. Text button replaced
         by a three-bar icon (user order) — same id, same toggle behaviour. -->
    <ImageButton
        android:id="@+id/roomPlayList"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/glass_icon_3d"
        android:elevation="8dp"
        android:src="@drawable/ic_menu_bars"
        android:scaleType="centerInside"
        android:contentDescription="Play List" />
</FrameLayout>
