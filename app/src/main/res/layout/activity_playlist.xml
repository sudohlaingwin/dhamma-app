<?xml version="1.0" encoding="utf-8"?>
<!-- v12.65: Personal Playlist (premium backlog #2) — the user's own lists (morning / bedtime / …) with their talks; tap a list to open it, tap a talk to play the list from there, Play All from the top. Rows are built in code (PlaylistActivity), like the Room's bookmark dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:id="@+id/plHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/plTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/maroon"
            android:textSize="20sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/plHeaderBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_btn_dark"
            android:minWidth="0dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <!-- v15.77 (slice 2120): Sort lists — the Bookmarks 2051 sort button on the lists screen: one tap cycles creation order -> newest first -> name A-Z, and the button names the current order (the label comes from Lang in code, so no literal sits here). GONE in detail (the 2065 rule — the header verbs show and hide together: Play All + Shuffle in detail, Sort in lists). Sort on the lists screen landed in slice 2120. -->
        <Button
            android:id="@+id/btnPlSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/glass_btn_dark"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- v15.73 (slice 2098): Shuffle play beside Play All — the chooser's v13.93 shuffle-play on the playlist detail screen: one tap shuffles the open list into the queue and opens the Room on the first shuffled talk. The two header verbs share one row (Play All weight 1 + Shuffle wrap, the Favourites header-row shape) so they show and hide together; the labels come from Lang in code, so no literal sits here. Shuffle play landed in slice 2098. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/plPlayAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_btn_dark"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
        <Button
            android:id="@+id/plShuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/glass_btn_dark"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- v15.77 (slice 2122): second detail action row — the list-level verbs (Share + Copy) live here, not in the Play All row: four buttons in one row would clip Play All (measured first-hand: Play All + Shuffle + Share + Copy wrap to ~436dp against a 328-361dp budget, leaving Play All ~20-40dp for a ~117dp label — the slice-2122 adjudication). Row 1 keeps Play All + Shuffle (the 2098 shape, comfortable again); the two rows show and hide together (the 2065 rule). Copy playlist on the detail screen landed in slice 2122; Share moved down from the Play All row in the same slice. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <!-- v15.77 (slice 2121): Share list on the detail screen — the 2113 share verb's second surface (the open list's own screen): one tap shares the whole list as one message. Moved from the Play All row to the second action row in slice 2122 (four buttons in one row would clip Play All); the label comes from Lang in code, so no literal sits here. GONE in lists mode (the 2065 rule — the header verbs show and hide together). Share playlist on the detail screen landed in slice 2121. -->
        <Button
            android:id="@+id/btnPlShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_btn_dark"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
        <!-- v15.77 (slice 2122): Copy list on the detail screen — the 2114 copy verb's second surface (the open list's own screen): one tap opens the 2114 copy dialog prefilled with the open list's name. Beside Share in the second action row; the label comes from Lang in code, so no literal sits here. GONE in lists mode (the 2065 rule). Copy playlist on the detail screen landed in slice 2122. -->
        <Button
            android:id="@+id/btnPlCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/glass_btn_dark"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- v15.77 (slice 2123): third detail action row — Rename lives here, not in the second row: Share + Copy + Rename would need ~385dp against a 328-361dp budget (measured first-hand: Rename 171.3dp at 16sp), so the list-management verbs get their own row. Rename + Delete together need ~267dp and fit a 360dp screen (measured first-hand in slice 2124: Rename 171.3dp + Delete 61.7dp, Delete rides its 88dp minWidth), so Delete joins this row. The rows show and hide together (the 2065 rule). Rename playlist on the detail screen landed in slice 2123; Delete playlist on the detail screen landed in v15.77 (slice 2124). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <!-- v15.77 (slice 2123): Rename list on the detail screen — the 2111 rename verb's second surface (the open list's own screen): one tap opens the 2111 rename dialog prefilled with the open list's name; a successful rename stays on the renamed list instead of dropping back to the lists screen. The label comes from Lang in code, so no literal sits here. GONE in lists mode (the 2065 rule). Rename playlist on the detail screen landed in slice 2123. -->
        <Button
            android:id="@+id/btnPlRename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_btn_dark"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
        <!-- v15.77 (slice 2124): Delete list on the detail screen — the v14.06 delete verb's second surface (the open list's own screen): one tap opens the delete confirm for the open list; confirming deletes it and drops back to the lists screen (there is no list to stay on). Beside Rename in the third action row. The label comes from Lang in code (the reused pl_delete_btn key), so no literal sits here. GONE in lists mode (the 2065 rule). Delete playlist on the detail screen landed in slice 2124. -->
        <Button
            android:id="@+id/btnPlDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/glass_btn_dark"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- v14.06 (F5, sixth pass slice 5): same bottom-edge
         empty text as History - the FrameLayout centers it in
         the list area; ids unchanged, so refreshEmpty() works
         as before. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/plList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/plEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />
        <!-- v15.74 (slice 2103): jump-to-playing button — the floating gold ▶ stacked above the ↑ back-to-top (slice 2104, the Talks/Downloaded stacking: same 56dp oval, same maroon glyph, 88dp off the corner): the list tap already plays a talk, but a listener who scrolled away from the sounding row had no visible way back — the header is off-screen exactly when the jump is needed. GONE until a live session plays a talk in the open list AND that talk's row has scrolled off-screen. Jump to the playing talk landed in slice 2103. -->
        <TextView
            android:id="@+id/plJumpBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="88dp"
            android:background="@drawable/top_btn_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="@color/maroon"
            android:textSize="24sp"
            android:visibility="gone" />
        <!-- v15.74 (slice 2104): back-to-top button — the floating gold ↑ at the list's bottom-end corner (the Talks 1940 / Downloaded 2003 block verbatim: same 56dp oval, same maroon glyph, 16dp off the corner): the header tap already jumps to the top, but the header is off-screen exactly when the jump is needed, so deep in a long playlist the listener had to drag all the way back by hand. GONE until the list has scrolled past eight rows. Back to top landed in slice 2104. -->
        <TextView
            android:id="@+id/plTopBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/top_btn_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="↑"
            android:textColor="@color/maroon"
            android:textSize="24sp"
            android:visibility="gone" />
    </FrameLayout>
    <!-- v13.53: real mini-player, the same strip as Talks' (v4.31) —
         GONE while nothing plays, so the lists stay list-only. A
         list that is playing (Play All / tap a talk) now shows
         here: tap opens its Room, ▶/⏸ works from here, live
         state always correct; a dead session with a saved spot
         shows the ↺ resume strip instead. -->
    <LinearLayout
        android:id="@+id/nowStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/nav_glass"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- v13.90 (slice 1082): strip portrait sounding gold ring —
                 the 44dp portrait now sits in a 48dp frame whose
                 background is the shelf ring drawable (reused, no new
                 drawable) while a live session sounds, so the sounding
                 sayadaw reads in a still screenshot on every strip.
                 Same 4dp geometry as the Room header's 52/48dp frame
                 (v13.88) and the chooser header's 60/56dp frame
                 (v13.89); the 10dp gap moved to the frame, so the row
                 spacing is unchanged and the photo never moves or
                 shrinks. The frame owns visibility now (gone when no
                 sayadaw is recorded); the ring is off in resume mode
                 (nothing sounds) and while a talk has ended. -->
            <FrameLayout
                android:id="@+id/nowStripPhotoRing"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone">
                <com.h2h.dhamma.CircleImageView
                    android:id="@+id/nowStripPhoto"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:transitionName="roomSayadawPhoto" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nowStripText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nowStripSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/nowStripPrev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripToggle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripNext"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/nowStripProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#40C9A227"
            android:progressTint="#C9A227" />
    </LinearLayout>
</LinearLayout>
