<?xml version="1.0" encoding="utf-8"?>
<!-- v12.65: Personal Playlist (premium backlog #2) — the user's own lists (morning / bedtime / …) with their talks; tap a list to open it, tap a talk to play the list from there, Play All from the top. Rows are built in code (PlaylistActivity), like the Room's bookmark dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/plTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/maroon"
            android:textSize="20sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/plHeaderBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_btn_dark"
            android:minWidth="0dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
    <Button
        android:id="@+id/plPlayAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/glass_btn_dark"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />
    <!-- v14.06 (F5, sixth pass slice 5): same bottom-edge
         empty text as History - the FrameLayout centers it in
         the list area; ids unchanged, so refreshEmpty() works
         as before. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/plList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/plEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
    <!-- v13.53: real mini-player, the same strip as Talks' (v4.31) —
         GONE while nothing plays, so the lists stay list-only. A
         list that is playing (Play All / tap a talk) now shows
         here: tap opens its Room, ▶/⏸ works from here, live
         state always correct; a dead session with a saved spot
         shows the ↺ resume strip instead. -->
    <LinearLayout
        android:id="@+id/nowStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/nav_glass"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.h2h.dhamma.CircleImageView
                android:id="@+id/nowStripPhoto"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nowStripText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nowStripSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/nowStripPrev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripToggle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripNext"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/nowStripProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#40C9A227"
            android:progressTint="#C9A227" />
    </LinearLayout>
</LinearLayout>
