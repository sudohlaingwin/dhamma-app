<?xml version="1.0" encoding="utf-8"?>
<!-- v12.65: Personal Playlist (premium backlog #2) — the user's own lists (morning / bedtime / …) with their talks; tap a list to open it, tap a talk to play the list from there, Play All from the top. Rows are built in code (PlaylistActivity), like the Room's bookmark dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/plTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/maroon"
            android:textSize="20sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/plHeaderBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_btn_dark"
            android:minWidth="0dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
    <Button
        android:id="@+id/plPlayAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/glass_btn_dark"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />
    <ListView
        android:id="@+id/plList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/plEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
