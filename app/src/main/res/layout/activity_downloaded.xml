<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/dlHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⬇ ဒေါင်းလုဒ်လုပ်ပြီးသားများ"
        android:textColor="@color/maroon"
        android:textSize="24sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/dlSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Downloads/Dhamma · အင်တာနက်မလိုဘဲ နားထောင်နိုင်ပါသည်"
        android:textColor="@color/muted"
        android:textSize="13sp" />
    <LinearLayout
        android:id="@+id/dlBtnRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnDlSort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="↕ နောက်ဆုံးဒေါင်းလုဒ်" />
        <Button
            android:id="@+id/btnDlRandom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="🎲 ကျပန်း ဖွင့်" />
    </LinearLayout>
    <Button
        android:id="@+id/btnDlPlayAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="▶ အားလုံး ဆက်တိုက် ဖွင့်မယ်" />
    <Button
        android:id="@+id/btnDlDeleteAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🗑 အားလုံး ဖျက်မယ်" />
    <LinearLayout
        android:id="@+id/dlSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/searchDl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ဒေါင်းလုဒ်လုပ်ထားတဲ့ တရား ရှာပါ…"
            android:inputType="text"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />
        <Button
            android:id="@+id/btnClearDlSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="✕" />
    </LinearLayout>
    <TextView
        android:id="@+id/totalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ဒေါင်းလုဒ်လုပ်ထားတာ မရှိသေးပါ။ မိုဘိုင်းဒေတာနဲ့ တရားဖွင့်ရင် “Wi-Fi ရမှ ဒေါင်းလုဒ်လုပ်မယ်” ကို ရွေးပါ။"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:visibility="gone" />
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true" />
    <!-- v4.86: queue preview above the strip — the library mirror
         of the Room's v4.83 preview: up to 3 following talks plus
         a gold count header, built by refreshLibQueuePreview on
         the 1s tick. GONE takes no space. -->
    <LinearLayout
        android:id="@+id/dlQueuePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone" />
    <!-- v4.40: real mini-player, the same strip as Main (v4.15/v4.30)
         and Talks (v4.31) — the library was the last playback
         surface without one, so a listener browsing downloads had
         only the notification card for pause/next. Pinned below
         the list (weight 1 above shrinks it); GONE takes no space. -->
    <LinearLayout
        android:id="@+id/nowStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/nav_glass"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.h2h.dhamma.CircleImageView
                android:id="@+id/nowStripPhoto"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nowStripText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nowStripSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">
            <TextView
                android:id="@+id/nowStripPrev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripToggle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/nowStripNext"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_margin="2dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            
            
            
            </LinearLayout>
        
        <ProgressBar
            android:id="@+id/nowStripProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#40C9A227"
            android:progressTint="#C9A227" />
    </LinearLayout>

</LinearLayout>
